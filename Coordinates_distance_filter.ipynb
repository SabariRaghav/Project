   "source": [
    "points = [(1,2),(4,4),(0,3),(6,1),(2,2)]\n",
    "\n",
    "for point in points:\n",
    "    \n",
    "    x=point[0]\n",
    "    y=point[1]\n",
    "    \n",
    "    distance=(x**2 + y**3)**0.5\n",
    "    \n",
    "    if distance<=5:\n",
    "        print(point,\"point is within the distance\")"
   ]
  }
